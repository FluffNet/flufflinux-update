msgid "System Updates"
msgstr "Համակարգի թարմացումներ"

msgid "Fluff Linux Update"
msgstr "Fluff Linux Update"

msgid "Keep Fluff Linux secure and up to date by installing system updates."
msgstr "Պահպանեք Fluff Linux-ի անվտանգությունն ու արդիականությունը՝ տեղադրելով համակարգի թարմացումները։"

msgid "System last updated: %1 (%2)"
msgstr "Համակարգի վերջին թարմացումը՝ %1 (%2)"

msgid "Check for Updates"
msgstr "Ստուգել թարմացումները"

msgid "Install Updates"
msgstr "Տեղադրել թարմացումները"

msgid "View Updates"
msgstr "Դիտել թարմացումները"

msgid "Change view"
msgstr "Փոխել տեսքը"

msgid "Updates to Install"
msgstr "Տեղադրվելիք թարմացումներ"

msgid "Package details are unavailable."
msgstr "Փաթեթի մանրամասները հասանելի չեն։"

msgid "Fluff Linux Update is still under development. If you encounter an issue, please report it on our GitHub page."
msgstr "Fluff Linux Update-ը դեռ մշակվում է։ Խնդրի հանդիպելու դեպքում հաղորդեք դրա մասին մեր GitHub էջում։"

msgid "System updates were installed successfully."
msgstr "Համակարգի թարմացումները հաջողությամբ տեղադրվեցին։"

msgid "GitHub"
msgstr "GitHub"

msgid "No network connection!"
msgstr "Ցանցային կապ չկա։"

msgid "Network connection is limited. If you are not connected to an organizational network, please check your internet connection."
msgstr "Ցանցային կապը սահմանափակ է։ Եթե կազմակերպության ցանցին միացած չեք, ստուգեք ինտերնետային կապը։"

msgid "pacman process is already running."
msgstr "pacman գործընթացն արդեն աշխատում է։"

msgid "The update process could not be started."
msgstr "Չհաջողվեց սկսել թարմացման գործընթացը։"

msgid "The update process could not be cancelled."
msgstr "Չհաջողվեց չեղարկել թարմացման գործընթացը։"

msgid "Connection failed while downloading updates. Check your network and try again."
msgstr "Թարմացումները ներբեռնելիս կապը խափանվեց։ Ստուգեք ցանցը և կրկին փորձեք։"

msgid "The system update failed."
msgstr "Համակարգի թարմացումը ձախողվեց։"

msgid "Downloading updates…"
msgstr "Թարմացումները ներբեռնվում են…"

msgid "Installing updates…"
msgstr "Թարմացումները տեղադրվում են…"

msgid "%1 / %2 downloaded"
msgstr "Ներբեռնված է %1 / %2"

msgid "%1/%2 updates installed"
msgstr "Տեղադրված է %1/%2 թարմացում"

msgid "Updates are currently being installed. Please avoid powering off or restarting the computer until installation is complete. Interrupting the update may damage system files."
msgstr "Թարմացումներն այժմ տեղադրվում են։ Մի անջատեք կամ վերագործարկեք համակարգիչը մինչև տեղադրման ավարտը։ Թարմացման ընդհատումը կարող է վնասել համակարգի ֆայլերը։"

msgid "The battery is low. Please connect your computer to a charger while installing updates."
msgstr "Մարտկոցի լիցքը ցածր է։ Թարմացումները տեղադրելիս համակարգիչը միացրեք լիցքավորիչին։"

msgid "Update process was cancelled"
msgstr "Թարմացման գործընթացը չեղարկվեց"

msgid "Cancel"
msgstr "Չեղարկել"

msgid "Checking for updates…"
msgstr "Թարմացումները ստուգվում են…"

msgid "System updates are available"
msgstr "Համակարգի թարմացումներ կան"

msgid "Download size: %1"
msgstr "Ներբեռնման չափը՝ %1"

msgid "Storage required for system updates: %1"
msgstr "Համակարգի թարմացումների համար անհրաժեշտ տարածքը՝ %1"

msgid "Storage freed after update: %1"
msgstr "Թարմացումից հետո ազատվող տարածքը՝ %1"

msgid "No additional download required"
msgstr "Լրացուցիչ ներբեռնում չի պահանջվում"

msgid "The update checker could not be started. Make sure pacman-contrib is installed."
msgstr "Չհաջողվեց գործարկել թարմացումների ստուգիչը։ Համոզվեք, որ pacman-contrib-ը տեղադրված է։"

msgid "The update check stopped unexpectedly."
msgstr "Թարմացումների ստուգումն անսպասելիորեն դադարեց։"

msgid "An unknown error has occurred. Please report this issue on our GitHub page for assistance."
msgstr "Անհայտ սխալ է տեղի ունեցել։ Օգնության համար խնդրի մասին հաղորդեք մեր GitHub էջում։"

msgid "No internet connection. Check your network and try again."
msgstr "Ինտերնետային կապ չկա։ Ստուգեք ցանցը և կրկին փորձեք։"

msgid "The repository servers could not be reached. Try again later or check your mirror configuration."
msgstr "Շտեմարանի սերվերները հասանելի չեն։ Փորձեք ավելի ուշ կամ ստուգեք հայելային սերվերի կարգավորումները։"

msgid "Authorization error, please try again."
msgstr "Լիազորման սխալ, կրկին փորձեք։"

msgid "The privileged update check stopped unexpectedly."
msgstr "Բարձր արտոնություններով թարմացումների ստուգումն անսպասելիորեն դադարեց։"

msgid "The privileged update check could not be started."
msgstr "Չհաջողվեց սկսել բարձր արտոնություններով թարմացումների ստուգումը։"

msgid "System was not previously updated."
msgstr "Համակարգը նախկինում չի թարմացվել։"

msgid "The last update information could not be read."
msgstr "Չհաջողվեց կարդալ վերջին թարմացման տվյալները։"

msgid "The last update information is invalid."
msgstr "Վերջին թարմացման տվյալները անվավեր են։"

msgid "Updates were not installed on this system"
msgstr "Այս համակարգում թարմացումներ չեն տեղադրվել"

msgid "To update the system, check for available updates using the button below."
msgstr "Համակարգը թարմացնելու համար ստորև բերված կոճակով ստուգեք հասանելի թարմացումները։"

msgid "Update date available"
msgstr "Թարմացման ամսաթիվը հասանելի է"

msgid "Updated recently"
msgstr "Վերջերս է թարմացվել"

msgid "System is up to date"
msgstr "Համակարգն արդիական է"

msgid "Last update was installed more than a month ago"
msgstr "Վերջին թարմացումը տեղադրվել է ավելի քան մեկ ամիս առաջ"

msgid "Last update was installed more than three months ago"
msgstr "Վերջին թարմացումը տեղադրվել է ավելի քան երեք ամիս առաջ"

msgid "%1 second ago"
msgid_plural "%1 seconds ago"
msgstr[0] "%1 վայրկյան առաջ"
msgstr[1] "%1 վայրկյան առաջ"

msgid "%1 minute ago"
msgid_plural "%1 minutes ago"
msgstr[0] "%1 րոպե առաջ"
msgstr[1] "%1 րոպե առաջ"

msgid "%1 hour ago"
msgid_plural "%1 hours ago"
msgstr[0] "%1 ժամ առաջ"
msgstr[1] "%1 ժամ առաջ"

msgid "%1 day ago"
msgid_plural "%1 days ago"
msgstr[0] "%1 օր առաջ"
msgstr[1] "%1 օր առաջ"

msgid "Action is required"
msgstr "Գործողություն է պահանջվում"

msgid "Action is required!"
msgstr "Գործողություն է պահանջվում։"

msgid "Action required"
msgstr "Պահանջվող գործողություն"

msgid "Fluff Linux Update cannot continue because the upcoming update requires removing “%1”, which is a protected system package. Removing it could prevent Fluff Linux from working correctly. Please report this issue on GitHub for assistance."
msgstr "Fluff Linux Update-ը չի կարող շարունակել, քանի որ առաջիկա թարմացումը պահանջում է հեռացնել պաշտպանված համակարգային “%1” փաթեթը։ Այն հեռացնելը կարող է խանգարել Fluff Linux-ի ճիշտ աշխատանքին։ Օգնության համար խնդրի մասին հաղորդեք GitHub-ում։"

msgid "To allow the system to install updates, Fluff Linux Update needs to remove “%1”. Removing this package may affect related software. If you are not sure, please report the issue on GitHub for help."
msgstr "Թարմացումները տեղադրելու համար Fluff Linux Update-ը պետք է հեռացնի “%1”-ը։ Այս փաթեթը հեռացնելը կարող է ազդել առնչվող ծրագրերի վրա։ Եթե վստահ չեք, օգնության համար խնդրի մասին հաղորդեք GitHub-ում։"

msgid "Accept"
msgstr "Ընդունել"

msgid "Close"
msgstr "Փակել"

msgid "To allow system updates to continue, %1 was automatically removed after it was deemed safe to remove."
msgstr "Համակարգի թարմացումները շարունակելու համար %1-ն ինքնաշխատ հեռացվեց՝ հեռացումն անվտանգ համարելուց հետո։"

msgid "To allow system updates to continue, the following packages were automatically removed after they were deemed safe to remove: %1"
msgstr "Համակարգի թարմացումները շարունակելու համար հետևյալ փաթեթերն ինքնաշխատ հեռացվեցին՝ հեռացումն անվտանգ համարելուց հետո՝ %1"

msgid "A file conflict was detected and resolved. %1 was renamed to %2. The update process has restarted."
msgstr "Հայտնաբերվեց և լուծվեց ֆայլերի հակասություն։ %1-ը վերանվանվեց %2։ Թարմացման գործընթացը վերսկսվեց։"

msgid "The conflicting package could not be removed. Please seek support."
msgstr "Չհաջողվեց հեռացնել հակասող փաթեթը։ Դիմեք աջակցությանը։"

msgid "Fluff Linux Update could not verify the FluffNet repository signing key. The update was stopped to protect your system."
msgstr "Fluff Linux Update-ը չկարողացավ ստուգել FluffNet շտեմարանի ստորագրման բանալին։ Ձեր համակարգը պաշտպանելու համար թարմացումը դադարեցվեց։"

msgid "Fluff Linux Update could not verify the FluffNet repository signing key. The update was stopped to protect your system. This may indicate a network problem, an unavailable FluffNet server, an expired or rotated signing key, a repository configuration problem, an unexpected key, or a possible repository compromise. Do not manually accept an unexpected key unless Fluff Linux publishes verified instructions."
msgstr "Fluff Linux Update-ը չկարողացավ ստուգել FluffNet շտեմարանի ստորագրման բանալին։ Ձեր համակարգը պաշտպանելու համար թարմացումը դադարեցվեց։ Սա կարող է նշանակել ցանցի խնդիր, անհասանելի FluffNet սերվեր, ժամկետանց կամ փոխարինված ստորագրման բանալի, շտեմարանի կարգավորման խնդիր, անսպասելի բանալի կամ շտեմարանի հնարավոր կոտրում։ Անսպասելի բանալին ձեռքով մի ընդունեք, եթե Fluff Linux-ը ստուգված հրահանգներ չի հրապարակել։"

msgid "Repository: %1"
msgstr "Շտեմարան՝ %1"

msgid "The official FluffNet repository signing key was verified and added to Pacman."
msgstr "FluffNet շտեմարանի պաշտոնական ստորագրման բանալին ստուգվեց և ավելացվեց Pacman-ին։"

msgid "Technical details"
msgstr "Տեխնիկական մանրամասներ"

msgid "Repository signing-key verification technical details"
msgstr "Շտեմարանի ստորագրման բանալու ստուգման տեխնիկական մանրամասներ"

msgid "Failure category: %1"
msgstr "Ձախողման կարգը՝ %1"

msgid "Expected fingerprint: %1"
msgstr "Սպասվող մատնահետքը՝ %1"

msgid "Received fingerprint: %1"
msgstr "Ստացված մատնահետքը՝ %1"

msgid "Requested signing-key fingerprint: %1"
msgstr "Պահանջված ստորագրման բանալու մատնահետքը՝ %1"

msgid "Pacman exit status: %1"
msgstr "Pacman-ի ելքի կարգավիճակը՝ %1"

msgid "FLU version: %1"
msgstr "FLU-ի տարբերակը՝ %1"

msgid "Fluff Linux version: %1"
msgstr "Fluff Linux-ի տարբերակը՝ %1"

msgid "Try Again"
msgstr "Կրկին փորձել"

msgid "Copy Technical Details"
msgstr "Պատճենել տեխնիկական մանրամասները"

msgid "Open an Issue on GitHub"
msgstr "Խնդիր գրանցել GitHub-ում"

msgid "There is not enough free storage to continue the update. Free up space and try again."
msgstr "Թարմացումը շարունակելու համար ազատ տարածքը չի բավարարում։ Ազատեք տարածք և կրկին փորձեք։"

msgid "A package or repository signature could not be verified. The update was stopped. Check your system date and keyring, then try again."
msgstr "Չհաջողվեց ստուգել փաթեթի կամ շտեմարանի ստորագրությունը։ Թարմացումը դադարեցվեց։ Ստուգեք համակարգի ամսաթիվն ու բանալիների շտեմարանը և կրկին փորձեք։"

msgid "The package database is damaged or unreadable. The update was stopped. Please seek support before repairing the database."
msgstr "Փաթեթների տվյալների բազան վնասված է կամ անընթեռնելի։ Թարմացումը դադարեցվեց։ Բազան վերականգնելուց առաջ դիմեք աջակցությանը։"

msgid "A downloaded package is damaged or incomplete. The update was stopped. Please try again or use a different mirror."
msgstr "Ներբեռնված փաթեթը վնասված է կամ թերի։ Թարմացումը դադարեցվեց։ Կրկին փորձեք կամ օգտագործեք այլ հայելային սերվեր։"

msgid "The update could not read or write required files. Check filesystem permissions and disk health, then try again."
msgstr "Թարմացումը չկարողացավ կարդալ կամ գրել անհրաժեշտ ֆայլերը։ Ստուգեք ֆայլային համակարգի թույլտվություններն ու սկավառակի վիճակը և կրկին փորձեք։"

msgid "The updates could not be downloaded. Please try again or seek support."
msgstr "Չհաջողվեց ներբեռնել թարմացումները։ Կրկին փորձեք կամ դիմեք աջակցությանը։"

msgid "The update transaction could not be prepared. Please try again or seek support."
msgstr "Չհաջողվեց պատրաստել թարմացման գործարքը։ Կրկին փորձեք կամ դիմեք աջակցությանը։"

msgid "The update could not start because sleep prevention could not be enabled. Please try again."
msgstr "Թարմացումը չսկսվեց, քանի որ չհաջողվեց միացնել քնի կանխումը։ Կրկին փորձեք։"

msgid "The package database could not be locked. Close other package managers and check that the filesystem is writable, then try again."
msgstr "Չհաջողվեց կողպել փաթեթների տվյալների բազան։ Փակեք փաթեթների այլ կառավարիչները և համոզվեք, որ ֆայլային համակարգը գրելի է, ապա կրկին փորձեք։"

msgid "Estimated time: %1"
msgstr "Մոտավոր ժամանակը՝ %1"
