    <description xml:lang="pa_Guru_IN">Fluff Linux Update ਵਰਤੋ</description>
    <message xml:lang="pa_Guru_IN">Fluff Linux Update ਵਰਤਣ ਲਈ ਆਪਣਾ ਪਾਸਵਰਡ ਦਿਓ</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/flufflinux-update/flufflinux-update-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
