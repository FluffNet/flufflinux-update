<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Fluff Linux</vendor>
  <vendor_url>https://flufflinux.org</vendor_url>
  <icon_name>system-software-update</icon_name>

  <action id="org.flufflinux.update">
    <description>Use Fluff Linux Update</description>
    <description xml:lang="ar">استخدام تحديث فلاف لينكس</description>
    <description xml:lang="de">Fluff Linux Update verwenden</description>
    <description xml:lang="es">Usar Fluff Linux Update</description>
    <description xml:lang="fr">Utiliser Fluff Linux Update</description>
    <description xml:lang="he">שימוש בFluff Linux Update</description>
    <description xml:lang="ja">Fluff Linux Update を使用</description>
    <description xml:lang="ru">Использование Fluff Linux Update</description>
    <description xml:lang="sv">Använd Fluff Linux Update</description>

    <description xml:lang="bg">Използване на Fluff Linux Update</description>
    <description xml:lang="bn">Fluff Linux Update ব্যবহার করুন</description>
    <description xml:lang="cs">Použít Fluff Linux Update</description>
    <description xml:lang="da">Brug Fluff Linux Update</description>
    <description xml:lang="el">Χρήση του Fluff Linux Update</description>
    <description xml:lang="et">Fluff Linux Update'i kasutamine</description>
    <description xml:lang="fa">استفاده از Fluff Linux Update</description>
    <description xml:lang="fi">Käytä Fluff Linux Updatea</description>
    <description xml:lang="fil">Gamitin ang Fluff Linux Update</description>
    <description xml:lang="ga">Úsáid Fluff Linux Update</description>
    <description xml:lang="hi">Fluff Linux Update इस्तेमाल करें</description>
    <description xml:lang="hr">Koristi Fluff Linux Update</description>
    <description xml:lang="hu">A Fluff Linux Update használata</description>
    <description xml:lang="id">Gunakan Fluff Linux Update</description>
    <description xml:lang="it">Usa Fluff Linux Update</description>
    <description xml:lang="ko">Fluff Linux Update 사용</description>
    <description xml:lang="lt">Naudoti Fluff Linux Update</description>
    <description xml:lang="lv">Izmantot Fluff Linux Update</description>
    <description xml:lang="ms">Gunakan Fluff Linux Update</description>
    <description xml:lang="mt">Uża Fluff Linux Update</description>
    <description xml:lang="nb">Bruk Fluff Linux Update</description>
    <description xml:lang="nl">Fluff Linux Update gebruiken</description>
    <description xml:lang="pl">Używanie Fluff Linux Update</description>
    <description xml:lang="pt">Usar o Fluff Linux Update</description>
    <description xml:lang="ro">Utilizați Fluff Linux Update</description>
    <description xml:lang="sk">Použiť Fluff Linux Update</description>
    <description xml:lang="sl">Uporabi Fluff Linux Update</description>
    <description xml:lang="sr">Користите Fluff Linux Update</description>
    <description xml:lang="sw">Tumia Fluff Linux Update</description>
    <description xml:lang="th">ใช้ Fluff Linux Update</description>
    <description xml:lang="tr">Fluff Linux Update kullan</description>
    <description xml:lang="uk">Використання Fluff Linux Update</description>
    <description xml:lang="ur">Fluff Linux Update استعمال کریں</description>
    <description xml:lang="vi">Sử dụng Fluff Linux Update</description>

    <message>Enter your password to use Fluff Linux Update</message>
    <message xml:lang="ar">أدخل كلمة مرورك لاستخدام تحديث فلاف لينكس</message>
    <message xml:lang="de">Geben Sie Ihr Passwort ein, um Fluff Linux Update zu verwenden</message>
    <message xml:lang="es">Introduzca su contraseña para usar Fluff Linux Update</message>
    <message xml:lang="fr">Saisissez votre mot de passe pour utiliser Fluff Linux Update</message>
    <message xml:lang="he">יש להזין את הסיסמה שלך כדי להשתמש בFluff Linux Update</message>
    <message xml:lang="ja">Fluff Linux Update を使用するにはパスワードを入力してください</message>
    <message xml:lang="ru">Введите пароль, чтобы использовать Fluff Linux Update</message>
    <message xml:lang="sv">Ange ditt lösenord för att använda Fluff Linux Update</message>

    <message xml:lang="bg">Въведете паролата си, за да използвате Fluff Linux Update</message>
    <message xml:lang="bn">Fluff Linux Update ব্যবহার করতে আপনার পাসওয়ার্ড দিন</message>
    <message xml:lang="cs">Zadejte heslo pro použití Fluff Linux Update</message>
    <message xml:lang="da">Indtast din adgangskode for at bruge Fluff Linux Update</message>
    <message xml:lang="el">Εισαγάγετε τον κωδικό πρόσβασής σας για να χρησιμοποιήσετε το Fluff Linux Update</message>
    <message xml:lang="et">Fluff Linux Update'i kasutamiseks sisestage oma parool</message>
    <message xml:lang="fa">برای استفاده از Fluff Linux Update گذرواژهٔ خود را وارد کنید</message>
    <message xml:lang="fi">Anna salasanasi käyttääksesi Fluff Linux Updatea</message>
    <message xml:lang="fil">Ilagay ang iyong password upang gamitin ang Fluff Linux Update</message>
    <message xml:lang="ga">Cuir isteach d'fhocal faire chun Fluff Linux Update a úsáid</message>
    <message xml:lang="hi">Fluff Linux Update इस्तेमाल करने के लिए अपना पासवर्ड दर्ज करें</message>
    <message xml:lang="hr">Unesite lozinku za korištenje programa Fluff Linux Update</message>
    <message xml:lang="hu">Adja meg jelszavát a Fluff Linux Update használatához</message>
    <message xml:lang="id">Masukkan kata sandi untuk menggunakan Fluff Linux Update</message>
    <message xml:lang="it">Inserisci la password per usare Fluff Linux Update</message>
    <message xml:lang="ko">Fluff Linux Update를 사용하려면 암호를 입력하세요</message>
    <message xml:lang="lt">Įveskite slaptažodį, kad galėtumėte naudoti Fluff Linux Update</message>
    <message xml:lang="lv">Ievadiet paroli, lai izmantotu Fluff Linux Update</message>
    <message xml:lang="ms">Masukkan kata laluan anda untuk menggunakan Fluff Linux Update</message>
    <message xml:lang="mt">Daħħal il-password tiegħek biex tuża Fluff Linux Update</message>
    <message xml:lang="nb">Skriv inn passordet ditt for å bruke Fluff Linux Update</message>
    <message xml:lang="nl">Voer uw wachtwoord in om Fluff Linux Update te gebruiken</message>
    <message xml:lang="pl">Wprowadź hasło, aby użyć Fluff Linux Update</message>
    <message xml:lang="pt">Introduza a sua palavra-passe para usar o Fluff Linux Update</message>
    <message xml:lang="ro">Introduceți parola pentru a utiliza Fluff Linux Update</message>
    <message xml:lang="sk">Zadajte heslo na použitie Fluff Linux Update</message>
    <message xml:lang="sl">Vnesite geslo za uporabo Fluff Linux Update</message>
    <message xml:lang="sr">Унесите лозинку да бисте користили Fluff Linux Update</message>
    <message xml:lang="sw">Weka nenosiri lako ili kutumia Fluff Linux Update</message>
    <message xml:lang="th">ป้อนรหัสผ่านเพื่อใช้ Fluff Linux Update</message>
    <message xml:lang="tr">Fluff Linux Update kullanmak için parolanızı girin</message>
    <message xml:lang="uk">Введіть пароль, щоб скористатися Fluff Linux Update</message>
    <message xml:lang="ur">Fluff Linux Update استعمال کرنے کے لیے اپنا پاس ورڈ درج کریں</message>
    <message xml:lang="vi">Nhập mật khẩu để sử dụng Fluff Linux Update</message>

    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/flufflinux-update/flufflinux-update-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
